[Unit]
Description=DHCP service for the Wireless Android Auto AP
Requires=aawg-wifi-ap.service
After=aawg-wifi-ap.service
Before=aawgd.service
PartOf=aawg-wifi-ap.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --no-daemon --conf-file=/etc/aawg-dnsmasq.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
